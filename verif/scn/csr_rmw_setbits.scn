# CSR read-modify-write (csrrs) on mscratch; the readback must see the modified value.
@name csr-rmw-setbits
@verifies funcCsrExecuteAtCommit funcCsrWriteProtocol funcSerializeGate funcSerializingTag
@maxcycles 200
li x1, 0xF0
csrrw x0, mscratch, x1
li x6, 0x0F
csrrs x5, mscratch, x6
csrrs x3, mscratch, x0
check x3 == 0xFF
