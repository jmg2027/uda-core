#!/usr/bin/env bash
# UDACore pre-commit gate. Activated by: git config core.hooksPath .githooks
# (the .claude session-start hook sets this automatically).
#
# ASCII is checked against staged bytes, including on macOS without GNU grep.
# spec-check inspects the complete working tree when core Scala sources are staged;
# stage the validated source snapshot together before committing.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1. ASCII check on staged text sources.
if ! python3 - <<'PY_ASCII'
import pathlib
import subprocess
import sys

suffixes = {".scala", ".md", ".sh", ".txt", ".sbt", ".scn", ".tcl", ".sdc", ".awk", ".py",
            ".sv", ".v", ".json", ".properties", ".yml", ".yaml", ".conf", ".S", ".c", ".h"}
paths = subprocess.check_output([
    "git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"
]).decode().split("\0")
bad = []
for path in filter(None, paths):
    if pathlib.Path(path).suffix not in suffixes:
        continue
    data = subprocess.check_output(["git", "show", ":" + path])
    if not data.isascii():
        lines = [str(i) for i, line in enumerate(data.splitlines(), 1) if not line.isascii()]
        bad.append(path + ":" + ",".join(lines))
if bad:
    print("pre-commit: non-ASCII in staged files (files must use English ASCII):", file=sys.stderr)
    for path in bad:
        print("  " + path, file=sys.stderr)
    sys.exit(1)
PY_ASCII
then
  exit 1
fi

# 2. spec-check when Scala sources are staged
if printf '%s\n' "$staged" | grep -q '^src/main/scala/.*\.scala$'; then
  if ! python3 "$ROOT/tools/spec-check.py" >/tmp/spec-check-precommit.log 2>&1; then
    echo "pre-commit: tools/spec-check.py FAILED (ADR-015 gate):" >&2
    tail -20 /tmp/spec-check-precommit.log >&2
    exit 1
  fi
fi

exit 0
